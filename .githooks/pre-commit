#!/bin/sh
# FILE: .githooks/pre-commit
# Purpose: keep assets/search-index.js in step with index.html on every
# local commit. Steps: 1) regenerate the index; 2) stage it if it changed.
# Install once per clone with: sh scripts/install_hooks.sh
cd "$(git rev-parse --show-toplevel)" || exit 1
python3 scripts/build_search_index.py >/dev/null || exit 1
git add assets/search-index.js
